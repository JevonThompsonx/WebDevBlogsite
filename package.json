{
  "name": "webdevblogsite",
  "version": "2.0.0",
  "private": true,
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": "22.x",
    "bun": "1.3.10"
  },
  "scripts": {
    "dev": "bun run db:migrate && next dev",
    "build": "bun run db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run drizzle/migrate.ts",
    "db:seed": "bun run drizzle/seed.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.38.0",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "shiki": "4.4.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix"
    ]
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
